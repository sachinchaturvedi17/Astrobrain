# AstroNaradMuni v1.4.0 — Hostinger Business Web Hosting LiteSpeed .htaccess (place in public_html/.htaccess)
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType model/gltf-binary .glb
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route all /api/* requests (POST /api/v10/*, GET /api/v10/kundli-pdf, GET /api/v10/admin/users) to api_gateway.php
    RewriteRule ^api/ api_gateway.php [QSA,L]

    # Serve existing static files directly via LiteSpeed
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback to index.html for SPA root
    RewriteRule ^ index.html [L]
</IfModule>
